{
    "name": "smolevich/reindexer-client",
    "description": "PHP client for using database reindexer",
    "type": "library",
    "minimum-stability": "stable",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "php-coveralls/php-coveralls": "^2.7",
        "grpc/grpc": "^1.57",
        "google/protobuf": "^4.26 || ^5.0",
        "infection/infection": "^0.34.1",
        "phpbench/phpbench": "^1.7"
    },
    "suggest": {
        "ext-grpc": "Required for the gRPC transport (install via pecl/pie, >= 1.42)",
        "grpc/grpc": "Required for the gRPC transport (^1.57)",
        "google/protobuf": "Required for the gRPC transport (^4.26 || ^5.0)",
        "ext-protobuf": "Speeds up protobuf serialization for the gRPC transport"
    },
    "autoload": {
        "psr-4": {
            "Reindexer\\": "src/Reindexer/",
            "Reindexer\\Grpc\\": "src/Grpc/Generated/Reindexer/Grpc/",
            "GPBMetadata\\": "src/Grpc/Generated/GPBMetadata/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Reindexer\\Benchmarks\\": "benchmarks/"
        }
    },
    "authors": [
        {
            "name": "Stanislav Shupilkin",
            "email": "smolevich90@gmail.com"
        }
    ],
    "scripts": {
        "run-test": "phpunit",
        "proto-gen": "protoc --proto_path=proto --php_out=src/Grpc/Generated --grpc_out=src/Grpc/Generated --plugin=protoc-gen-grpc=$(which grpc_php_plugin) proto/reindexer.proto",
        "style-fix": "php-cs-fixer fix",
        "check-fix": "php-cs-fixer fix --dry-run",
        "bench-seed": "php benchmarks/seed.php",
        "bench-load": "php benchmarks/load.php",
        "bench": "phpbench run --report=aggregate"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "process-timeout": 0
    }
}
